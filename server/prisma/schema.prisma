generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OpportunityStatus {
  DISCOVERED
  QUALIFIED
  HYPOTHESIS
  EXPERIMENT
  PROVING
  PROVEN
  REJECTED
  DEFERRED
  NO_AI
}

enum EvidenceType {
  FACT
  INFERENCE
  ASSUMPTION
  AI_HYPOTHESIS
}

enum ExperimentStatus {
  PLANNED
  RUNNING
  COMPLETE
  ABANDONED
}

model Opportunity {
  id              String            @id @default(cuid())
  title           String
  description     String?
  businessProblem String?
  potentialValue  String?
  complexity      String?
  dependencies    String?
  aiSuitability   String?
  risks           String?
  owner           String?
  hypothesis      String?
  status          OpportunityStatus @default(DISCOVERED)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  evidence        Evidence[]
  decisions       Decision[]
  experiments     Experiment[]
  reports         OpportunityReport[]
  companyId       String?
  company         Company?          @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

// A company the team is working on. Opportunities and analyses are filed under one. nameKey is the
// name trimmed, whitespace-collapsed and lower-cased, so "Maersk", "maersk" and " MAERSK " are one company.
model Company {
  id            String        @id @default(cuid())
  name          String
  nameKey       String        @unique
  website       String?
  createdAt     DateTime      @default(now())
  opportunities Opportunity[]
  analysisJobs  AnalysisJob[]
  reports       CompanyReport[]
}

enum CompanyReportStatus {
  GENERATING
  DRAFT
  APPROVED
  FAILED
}

enum DeliverableAudience {
  C_LEVEL
  TECHNICAL
}

enum DeliverableFormat {
  PPTX
  DOCX
}

// One version of the company-level report: the structured content all four files are rendered from.
// Versions are never overwritten; APPROVED locks a version (a human reviewed it).
model CompanyReport {
  id            String              @id @default(cuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id])
  version       Int
  status        CompanyReportStatus @default(GENERATING)
  stage         String?
  content       Json?
  sources       Json?
  qualityReport Json?
  errorMessage  String?
  createdAt     DateTime            @default(now())
  completedAt   DateTime?
  approvedAt    DateTime?
  approvedBy    String?
  deliverables  Deliverable[]

  @@unique([companyId, version])
  @@index([companyId, createdAt])
}

// A rendered file (stored in the database, rebuilt deterministically from CompanyReport.content).
model Deliverable {
  id              String              @id @default(cuid())
  companyReportId String
  companyReport   CompanyReport       @relation(fields: [companyReportId], references: [id], onDelete: Cascade)
  audience        DeliverableAudience
  format          DeliverableFormat
  filename        String
  content         Bytes
  sizeBytes       Int
  createdAt       DateTime            @default(now())

  @@unique([companyReportId, audience, format])
}

// An AI-generated report for an opportunity. Every generation is kept; the newest is the one shown.
model OpportunityReport {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  content       String
  model         String
  createdAt     DateTime    @default(now())

  @@index([opportunityId, createdAt])
}

model Evidence {
  id            String       @id @default(cuid())
  opportunityId String
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id])
  claim         String
  type          EvidenceType
  confidence    Float?
  source        String?
  location      String?
  excerpt       String?
  capturedAt    DateTime     @default(now())
}

model Decision {
  id                     String      @id @default(cuid())
  opportunityId          String
  opportunity            Opportunity @relation(fields: [opportunityId], references: [id])
  decision               String
  rationale              String?
  assumptions            String?
  confidence             Float?
  alternativesConsidered String?
  risks                  String?
  owner                  String?
  decidedAt              DateTime    @default(now())
}

model Experiment {
  id            String           @id @default(cuid())
  opportunityId String
  opportunity   Opportunity      @relation(fields: [opportunityId], references: [id])
  title         String
  method        String
  status        ExperimentStatus @default(PLANNED)
  resultSummary String?
  success       Boolean?
  startedAt     DateTime?
  completedAt   DateTime?
  learnings     Learning[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

enum AnalysisJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model AnalysisJob {
  id             String            @id @default(cuid())
  companyName    String
  status         AnalysisJobStatus @default(QUEUED)
  opportunityIds String[]
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime          @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  companyId      String?
  company        Company?          @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model Learning {
  id           String     @id @default(cuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id])
  insight      String
  createdAt    DateTime   @default(now())
}

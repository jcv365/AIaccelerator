# Required
DATABASE_URL=postgres://accelerator:accelerator@postgres:5432/accelerator
# PORT is effectively fixed at 4000: docker-compose.yml's healthcheck and
# port mapping for the server service, and client/nginx.conf's proxy target,
# both hardcode 4000. Changing it here alone will not work; you would also
# need to update those files.
PORT=4000

# Optional (enable features once available)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Development
NODE_ENV=development

# Production (documented now, required later when deploying beyond local Docker)
# CORS_ALLOWED_ORIGINS=
